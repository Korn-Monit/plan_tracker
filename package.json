{
  "name": "prompttrace",
  "displayName": "PromptTrace",
  "description": "Local-first prompt-aware file history for VS Code and Cursor.",
  "version": "0.0.1",
  "publisher": "prompttrace-local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:promptTrace.runSmokeTest",
    "onView:promptTrace.history",
    "onCommand:promptTrace.compareWithPrevious",
    "onCommand:promptTrace.compareWithCurrent",
    "onCommand:promptTrace.restoreRevision",
    "onCommand:promptTrace.handleClaudeHook"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptTrace.runSmokeTest",
        "title": "PromptTrace: Run Smoke Test"
      },
      {
        "command": "promptTrace.compareWithPrevious",
        "title": "PromptTrace: Compare with Previous Revision",
        "icon": "$(compare-changes)"
      },
      {
        "command": "promptTrace.compareWithCurrent",
        "title": "PromptTrace: Compare with Current File",
        "icon": "$(diff)"
      },
      {
        "command": "promptTrace.handleClaudeHook",
        "title": "PromptTrace: Receive Claude Code Hook",
        "enablement": "false"
      },
      {
        "command": "promptTrace.restoreRevision",
        "title": "PromptTrace: Restore Revision",
        "icon": "$(discard)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptTrace",
          "title": "PromptTrace",
          "icon": "resources/prompttrace.svg"
        }
      ]
    },
    "views": {
      "promptTrace": [
        {
          "id": "promptTrace.history",
          "name": "History",
          "icon": "resources/prompttrace.svg",
          "contextualTitle": "PromptTrace History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptTrace.history",
        "contents": "No Markdown history has been recorded yet.\n\nSave a Markdown file in this workspace to create a revision."
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "promptTrace.compareWithPrevious",
          "when": "view == promptTrace.history && viewItem == promptTraceRevision",
          "group": "inline@1"
        },
        {
          "command": "promptTrace.compareWithCurrent",
          "when": "view == promptTrace.history && viewItem == promptTraceRevision",
          "group": "inline@2"
        },
        {
          "command": "promptTrace.restoreRevision",
          "when": "view == promptTrace.history && viewItem == promptTraceRevision",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "PromptTrace",
      "properties": {
        "promptTrace.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PromptTrace for this editor window."
        },
        "promptTrace.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md",
            "**/*.markdown"
          ],
          "description": "Workspace-relative glob patterns for files whose history is captured."
        },
        "promptTrace.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/vendor/**",
            "**/dist/**",
            "**/build/**",
            "**/.prompttrace/**"
          ],
          "description": "Workspace-relative glob patterns excluded from history capture."
        },
        "promptTrace.debounceMilliseconds": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 5000,
          "description": "Delay used to coalesce noisy filesystem notifications. Editor saves are captured immediately."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "test": "npm run compile && node --test --test-isolation=none dist/test/*.test.js",
    "test:vscode": "npm run compile && node dist/test/runVsCodeIntegration.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "package": "npm run check && vsce package --allow-missing-repository --out prompttrace.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
