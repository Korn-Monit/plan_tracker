{
  "name": "plan-tracker",
  "displayName": "Plan Tracker",
  "description": "Local-first Markdown history for reviewing changes made by people and coding agents.",
  "version": "0.2.0",
  "publisher": "MonitKorn",
  "preview": true,
  "license": "MIT",
  "icon": "resources/plan-tracker.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Korn-Monit/plan_tracker.git"
  },
  "bugs": {
    "url": "https://github.com/Korn-Monit/plan_tracker/issues"
  },
  "homepage": "https://github.com/Korn-Monit/plan_tracker#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "history",
    "markdown",
    "diff",
    "ai",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:planTracker.runSmokeTest",
    "onView:planTracker.history",
    "onCommand:planTracker.compareWithPrevious",
    "onCommand:planTracker.compareWithCurrent",
    "onCommand:planTracker.restoreRevision",
    "onCommand:planTracker.deleteWorkspaceHistory",
    "onCommand:planTracker.handleClaudeHook"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "planTracker.runSmokeTest",
        "title": "Plan Tracker: Run Smoke Test"
      },
      {
        "command": "planTracker.compareWithPrevious",
        "title": "Plan Tracker: Compare with Previous Revision",
        "icon": "$(compare-changes)"
      },
      {
        "command": "planTracker.compareWithCurrent",
        "title": "Plan Tracker: Compare with Current File",
        "icon": "$(diff)"
      },
      {
        "command": "planTracker.handleClaudeHook",
        "title": "Plan Tracker: Receive Claude Code Hook",
        "enablement": "false"
      },
      {
        "command": "planTracker.restoreRevision",
        "title": "Plan Tracker: Restore Revision",
        "icon": "$(discard)"
      },
      {
        "command": "planTracker.deleteWorkspaceHistory",
        "title": "Plan Tracker: Delete Workspace History"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planTracker",
          "title": "Plan Tracker",
          "icon": "resources/plan-tracker.svg"
        }
      ]
    },
    "views": {
      "planTracker": [
        {
          "id": "planTracker.history",
          "name": "History",
          "icon": "resources/plan-tracker.svg",
          "contextualTitle": "Plan Tracker History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "planTracker.history",
        "contents": "No Markdown history has been recorded yet.\n\nSave a Markdown file in this workspace to create a revision."
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "planTracker.compareWithPrevious",
          "when": "view == planTracker.history && viewItem == planTrackerRevision",
          "group": "inline@1"
        },
        {
          "command": "planTracker.compareWithCurrent",
          "when": "view == planTracker.history && viewItem == planTrackerRevision",
          "group": "inline@2"
        },
        {
          "command": "planTracker.restoreRevision",
          "when": "view == planTracker.history && viewItem == planTrackerRevision",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Plan Tracker",
      "properties": {
        "planTracker.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Plan Tracker for this editor window."
        },
        "planTracker.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.md",
            "**/*.markdown"
          ],
          "description": "Workspace-relative glob patterns for files whose history is captured."
        },
        "planTracker.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.git/**",
            "**/node_modules/**",
            "**/vendor/**",
            "**/dist/**",
            "**/build/**",
            "**/.plan-tracker/**",
            "**/.vscode-test/**"
          ],
          "description": "Workspace-relative glob patterns excluded from history capture."
        },
        "planTracker.debounceMilliseconds": {
          "type": "number",
          "default": 250,
          "minimum": 50,
          "maximum": 5000,
          "description": "Delay used to coalesce noisy filesystem notifications. Editor saves are captured immediately."
        },
        "planTracker.maxAgeDays": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "description": "Maximum age of historical revisions in days. Current file heads are always retained. Set to 0 to disable age-based retention."
        },
        "planTracker.maxStorageMegabytes": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Maximum storage used by referenced snapshots, in MiB. Old history is removed first; current file heads are always retained. Set to 0 to disable size-based retention."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "compile": "tsc --project tsconfig.json",
    "watch": "tsc --watch --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "test": "npm run compile && node --test --test-isolation=none dist/test/*.test.js",
    "test:vscode": "npm run compile && node dist/test/runVsCodeIntegration.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "package": "npm run check && vsce package --allow-missing-repository --out plan-tracker.vsix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.0",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "ignore": "^7.0.14"
  }
}
